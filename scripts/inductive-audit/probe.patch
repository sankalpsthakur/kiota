+pub(crate) fn probe_level(l: &Level) -> String {
+    match &**l {
+        level::LevelData::Zero => "[\"z\"]".into(),
+        level::LevelData::Succ(a) => format!("[\"S\",{}]", probe_level(a)),
+        level::LevelData::Max(a, b) => format!("[\"m\",{},{}]", probe_level(a), probe_level(b)),
+        level::LevelData::IMax(a, b) => format!("[\"i\",{},{}]", probe_level(a), probe_level(b)),
+        level::LevelData::Param(n) => format!("[\"P\",{}]", n),
+    }
+}
+pub(crate) fn probe_expr(e: &Expr) -> String {
+    match &***e {
+        ExprData::BVar(i) => format!("[\"b\",{}]", i),
+        ExprData::Sort(l) => format!("[\"s\",{}]", probe_level(l)),
+        ExprData::Const(n, us) => format!("[\"c\",{},[{}]]", n, us.iter().map(probe_level).collect::<Vec<_>>().join(",")),
+        ExprData::App(f, a) => format!("[\"a\",{},{}]", probe_expr(f), probe_expr(a)),
+        ExprData::Lam(_, t, b) => format!("[\"l\",{},{}]", probe_expr(t), probe_expr(b)),
+        ExprData::Pi(_, t, b) => format!("[\"p\",{},{}]", probe_expr(t), probe_expr(b)),
+        ExprData::Let(t, v, b) => format!("[\"let\",{},{},{}]", probe_expr(t), probe_expr(v), probe_expr(b)),
+        ExprData::Proj(s, i, v) => format!("[\"proj\",{},{},{}]", s, i, probe_expr(v)),
+        ExprData::Lit(_) => "[\"lit\"]".into(),
+    }
+}
